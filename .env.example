NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://iipbmwpigedfslqybxmg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Accepts Supabase's sb_publishable_ public key in this variable.
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
# Optional SaaS rollout: dedicated test/business key; never falls back to legacy checkout.
SAAS_PAYSTACK_SECRET_KEY=
# 32 random bytes encoded as base64. Keep separate from provider/database keys.
# Required for explicitly authorized reusable payment tokens; never NEXT_PUBLIC_.
SAAS_BILLING_ENCRYPTION_KEY=
# Host scheduler invokes this canonical endpoint through scripts/saas-worker.cjs.
SAAS_WORKER_URL=
# Keep off until wildcard/custom hosting, HTTPS and central Auth redirects are commissioned.
SAAS_DOMAIN_ROUTING=false
# Platform landing page and shared business addresses, e.g. nex.nexzekbizhub.com.
SAAS_PLATFORM_SITE=false
# Explicit interface-only deployment; registration stays closed until setup is complete.
SAAS_SETUP_MODE=false
SAAS_TENANT_ROOT_DOMAIN=nexzekbizhub.com
# Explicit existing deployment aliases, comma-separated exact hosts. No wildcards.
SAAS_TRUSTED_APP_HOSTS=
# Deployment-only path to private backup/restore evidence; see docs/SAAS-OPERATIONS.md.
SAAS_MIGRATION_EVIDENCE=
# Optional when reservation expiry runs directly through Supabase Cron.
CRON_SECRET=
# Only permits a sandbox administrator on localhost, never production.
LOCAL_DEMO=true
LOCAL_DATABASE_PATH=.data/edgedirect2u.sqlite
# Deployment tools only; never NEXT_PUBLIC_ and never included in the client.
DATABASE_URL=
DATABASE_CA_PATH=
# Optional hosted acceptance profile. Offline tests do not require these values.
STAGING_DATABASE_URL=
STAGING_DATABASE_CA_PATH=
STAGING_PROJECT_REF=
